Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # ========== 地图 ==========
    - Class: rviz_default_plugins/Map
      Name: Map (Cartographer)
      Topic: /map
      Alpha: 0.7
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      Update Topic: /map_updates
      Use Timestamp: false
    # ========== Nav2 全局路径 ==========
    - Class: rviz_default_plugins/Path
      Name: Global Plan (/plan)
      Topic: /plan
      Color: 25; 255; 0            # 绿色
      Line Style: Dashed
      Line Width: 0.05
      Offset: 0.0; 0.0; 0.05       # 略微抬高防遮挡
      Enabled: true
    # ========== Nav2 局部路径 ==========
    - Class: rviz_default_plugins/Path
      Name: Local Plan (/local_plan)
      Topic: /local_plan
      Color: 255; 170; 0            # 橙色
      Line Style: Solid
      Line Width: 0.08
      Offset: 0.0; 0.0; 0.05
      Enabled: true
    # ========== LiDAR 扫描 ==========
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (/scan)
      Topic: /scan
      Style: Points                 # 点云模式, 性能更好
      Size (m): 0.03
      Color Transformer: Intensity
      Decay Time: 0.5
      Enabled: true
    # ========== 全局 costmap ==========
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Topic: /global_costmap/costmap
      Alpha: 0.5
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
    # ========== 局部 costmap ==========
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Topic: /local_costmap/costmap
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
      Enabled: true
    # ========== TF 坐标系 ==========
    - Class: rviz_default_plugins/TF
      Name: TF
      Frame Timeout: 15
      Enabled: true
    # ========== 机器人模型 ==========
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic: /robot_description
      Enabled: false                # 无 URDF 则关闭
    # ========== 导航目标箭头 ==========
    - Class: rviz_default_plugins/Marker
      Name: Goal Pose Marker
      Topic: /goal_pose
      Enabled: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map               # 以 SLAM map 帧为参考
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose            # Nav2 Goal 工具 → 自动关联
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: map
      Distance: 10.0
      Focal Point: 0.0; 0.0; 0.0
      Yaw: 0.0
      Pitch: 1.0                   # 俯视角度